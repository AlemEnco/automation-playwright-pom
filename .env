# Playwright Configuration
STORAGE_STATE_PATH=./auth-state.json
START_LOCAL_SERVER=false
BASE_URL=https://practicetestautomation.com

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/test.log

# Screenshots and Videos
SCREENSHOT_MODE=only-on-failure
VIDEO_MODE=retain-on-failure
TRACE_MODE=on-first-retry

# API Registro de Envíos - Auth
API_BASE_URL=https://restful-booker.herokuapp.com
AUTH_USERNAME=ext_client
AUTH_PASSWORD=123456
AUTH_CLIENT_ID=app_web_id
AUTH_CLIENT_SECRET=123456

# Test Environment Specific
ENVIRONMENT=development
TEST_SUITE=smoke
HEADLESS=false
BROWSER=chromium
TIMEOUT=30000
RETRIES=2

# Cambiar la cantidad de workers para evitar paralelismo
WORKERS=4
